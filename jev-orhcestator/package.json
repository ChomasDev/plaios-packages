{
  "name": "@agent-os/jev-orhcestator",
  "version": "0.1.8",
  "description": "TypeSafe Jev orchestrator that can send natural-language commands directly to capabilities",
  "keywords": ["agent-os", "capability", "orchestrator", "jev", "typesafe"],
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "web",
    "agent-os.package.yaml"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web/*": {
      "types": "./dist/web/*/index.d.ts",
      "import": "./dist/web/*/index.js"
    },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-os/core": "workspace:*",
    "@agent-os/env-node": "workspace:*",
    "@agent-os/microfrontend": "workspace:*",
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
