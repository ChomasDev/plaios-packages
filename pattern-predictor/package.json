{
  "name": "@plaios/pattern-predictor",
  "version": "0.1.2",
  "description": "Learns recurring requests from chat history and proactively offers them for PLAIOS",
  "keywords": [
    "plaios",
    "capability",
    "input",
    "prediction",
    "habits",
    "proactive"
  ],
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "web",
    "agent-os.package.yaml",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web/input": {
      "types": "./dist/web/input/index.d.ts",
      "import": "./dist/web/input/index.js"
    },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plaios/core": "workspace:*",
    "node-cron": "^4.2.1",
    "@plaios/microfrontend": "workspace:*"
  },
  "devDependencies": {
    "@plaios/sqlite": "workspace:*",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "@types/react": "^19.0.0",
    "react": "19.2.4"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
