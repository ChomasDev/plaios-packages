{
  "name": "agentos",
  "version": "0.7.7",
  "description": "Agent OS command line entrypoint",
  "keywords": ["agent-os", "cli", "capabilities", "agents"],
  "private": false,
  "type": "module",
  "bin": {
    "agentos": "./dist/src/cli.js"
  },
  "files": ["dist/src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-cli-executable.mjs",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-os/package-manager": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
