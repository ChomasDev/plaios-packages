{
  "name": "@agent-os/orchestrator-default",
  "version": "0.1.3",
  "description": "Model-backed capability and output router for Agent OS",
  "keywords": ["agent-os", "capability", "orchestrator", "routing", "ai"],
  "private": false,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "web", "agent-os.package.yaml", "README.md"],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" }, "./web/orchestrator": { "types": "./dist/web/orchestrator/index.d.ts", "import": "./dist/web/orchestrator/index.js" }, "./web/styles.css": "./web/styles.css" },
  "scripts": { "build": "tsc -p tsconfig.json", "test": "pnpm build && node --test test/**/*.test.mjs", "typecheck": "tsc --noEmit -p tsconfig.json" },
  "dependencies": { "@agent-os/core": "workspace:*", "@agent-os/microfrontend": "workspace:*" },
  "peerDependencies": { "react": ">=19.0.0" },
  "devDependencies": { "@types/node": "24.13.3", "@types/react": "^19.0.0", "react": "19.2.4", "typescript": "7.0.2" },
  "engines": { "node": ">=22.5.0" },
  "publishConfig": { "access": "public" }
}
