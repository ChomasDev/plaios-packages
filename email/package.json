{
  "name": "@plaios/email",
  "version": "0.1.0",
  "description": "Watches Gmail, Outlook and IMAP mailboxes, sorts each new email with the fast model and notifies you of the important ones",
  "keywords": [
    "plaios",
    "capability",
    "input",
    "email",
    "imap",
    "gmail",
    "outlook"
  ],
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "web",
    "agent-os.package.yaml",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web/input": {
      "types": "./dist/web/input/index.d.ts",
      "import": "./dist/web/input/index.js"
    },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plaios/core": "workspace:*",
    "@plaios/microfrontend": "workspace:*",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4"
  },
  "devDependencies": {
    "@plaios/sqlite": "workspace:*",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
