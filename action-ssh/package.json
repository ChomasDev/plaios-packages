{
  "name": "@plaios/action-ssh",
  "version": "0.2.0",
  "description": "SSH remote control for paired Macs and Linux computers, with TypeSafe Jev natural-language routing",
  "keywords": [
    "plaios",
    "capability",
    "action",
    "ssh",
    "macos",
    "remote",
    "computer"
  ],
  "private": false,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "web", "macos", "agent-os.package.yaml", "README.md"],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web/action": {
      "types": "./dist/web/action/index.d.ts",
      "import": "./dist/web/action/index.js"
    },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plaios/core": "workspace:*",
    "@plaios/microfrontend": "workspace:*",
    "@plaios/systems": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@plaios/system1-jev": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
