{
  "name": "@agent-os/memory-graph",
  "version": "0.3.0",
  "description": "Weighted, decaying, vector-ranked graph memory capability for Agent OS",
  "keywords": [
    "agent-os",
    "capability",
    "memory",
    "graph"
  ],
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "web",
    "agent-os.package.yaml",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web/memory": {
      "types": "./dist/src/web.d.ts",
      "import": "./dist/web/memory.js"
    },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs",
    "test": "pnpm build && node --test dist/test/index.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-os/core": "workspace:*",
    "@agent-os/microfrontend": "workspace:*",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react-force-graph-3d": "^1.29.1",
    "sigma": "^3.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@agent-os/sqlite": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
