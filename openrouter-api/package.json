{
  "name": "@agent-os/openrouter-api",
  "version": "0.1.0",
  "description": "OpenAI/OpenRouter-compatible HTTP input and output with OpenClaw protocol support",
  "keywords": ["agent-os", "openai", "openrouter", "openclaw", "api", "input", "output"],
  "private": false,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "web", "agent-os.package.yaml", "README.md"],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./web/input": { "types": "./dist/src/web.d.ts", "import": "./dist/src/web.js" },
    "./web/output": { "types": "./dist/src/web.d.ts", "import": "./dist/src/web.js" },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/test/http-api.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-os/core": "workspace:*",
    "@agent-os/microfrontend": "workspace:*",
    "ws": "^8.21.1"
  },
  "peerDependencies": { "react": ">=19.0.0" },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22.5.0" },
  "publishConfig": { "access": "public" }
}
