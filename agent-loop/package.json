{
  "name": "@agent-os/agent-loop",
  "version": "0.1.0",
  "description": "Default model and capability execution loop for Agent OS",
  "keywords": ["agent-os", "agent", "loop", "capabilities"],
  "private": false,
  "type": "module",
  "files": ["dist", "agent-os.package.yaml", "README.md"],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./web/agent": { "types": "./dist/src/web.d.ts", "import": "./dist/src/web.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test dist/test/index.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-os/core": "workspace:*",
    "@agent-os/microfrontend": "workspace:*"
  },
  "peerDependencies": { "react": ">=19.0.0" },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22.5.0" },
  "publishConfig": { "access": "public" }
}
