{
  "name": "@plaios/action-t3code",
  "version": "0.1.1",
  "description": "Drive T3 Code on a Mac over Tailscale: launch coding agents, manage projects and repos, open a project in the desktop app",
  "keywords": [
    "plaios",
    "capability",
    "action",
    "t3code",
    "mcp",
    "coding-agent",
    "tailscale"
  ],
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "web",
    "agent-os.package.yaml",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web/action": {
      "types": "./dist/web/action/index.d.ts",
      "import": "./dist/web/action/index.js"
    },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plaios/action-ssh": "workspace:*",
    "@plaios/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@plaios/microfrontend": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
