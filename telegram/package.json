{
  "name": "@agent-os/telegram",
  "version": "0.1.0",
  "description": "Telegram input and output capability for Agent OS",
  "keywords": [
    "agent-os",
    "capability",
    "telegram",
    "input",
    "output"
  ],
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "web",
    "agent-os.package.yaml"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./web/*": {
      "types": "./dist/web/*/index.d.ts",
      "import": "./dist/web/*/index.js"
    },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-os/core": "workspace:*",
    "@agent-os/microfrontend": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  }
}
