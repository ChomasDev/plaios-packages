{
  "name": "@plaios/systems",
  "version": "0.1.0",
  "description": "Shared System 1 / System 2 helpers for PLAIOS plugins: question builders, System 2 ask, remembered protocols",
  "keywords": [
    "plaios",
    "system1",
    "system2"
  ],
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plaios/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
