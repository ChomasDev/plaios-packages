{
  "name": "@plaios/cronjob",
  "version": "0.2.1",
  "description": "Persistent cron input and schedule-management capability for PLAIOS",
  "keywords": ["plaios", "capability", "input", "cron", "scheduler", "automation"],
  "private": false,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "web", "agent-os.package.yaml", "README.md"],
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./web/input": { "types": "./dist/web/input/index.d.ts", "import": "./dist/web/input/index.js" },
    "./web/styles.css": "./web/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/**/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@plaios/core": "workspace:*",
    "@plaios/microfrontend": "workspace:*",
    "node-cron": "^4.2.1"
  },
  "peerDependencies": { "react": ">=19.0.0" },
  "devDependencies": {
    "@plaios/sqlite": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "react": "19.2.4",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22.5.0" },
  "publishConfig": { "access": "public" }
}
